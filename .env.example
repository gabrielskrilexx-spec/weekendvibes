# WeekendVibes — variáveis de ambiente
# Nunca coloque valores reais de produção neste arquivo.

# Banco e sessão
DATABASE_URL=
JWT_SECRET=

# Origem HTTPS pública opcional para URLs canonical/OG fora da configuração Vercel
PUBLIC_SITE_URL=

# Segurança do painel administrativo: lista separada por vírgulas.
# O acesso é permitido somente para role=admin ou e-mail nesta lista.
ADMIN_EMAILS=weekendvibes.of@gmail.com

# Integrações externas
APIFY_API_TOKEN=
APIFY_INSTAGRAM_SESSION_COOKIE=
OPENAI_API_KEY=
META_INSTAGRAM_TOKEN=
META_INSTAGRAM_USER_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Web Push: a chave pública é embutida no bundle do frontend; nunca exponha a chave privada.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@weekendvibes.com

# Rotinas agendadas
INTERNAL_CRON_SECRET=
CRON_SECRET=

# Opcional: ajustes de execução
PUBLIC_AGENDA_TIMEOUT_MS=25000
INSTAGRAM_AGENDA_TIMEOUT_MS=30000
