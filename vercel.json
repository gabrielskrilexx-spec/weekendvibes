{
  "framework": "vite",
  "installCommand": "pnpm install --force --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/**,server/**,drizzle/**,shared/**}"
    }
  },
  "crons": [
    {
      "path": "/api/scheduled/ticketing-monitor",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
