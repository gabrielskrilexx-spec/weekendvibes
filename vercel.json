{
  "framework": "vite",
  "installCommand": "pnpm install --force --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/**,server/**,drizzle/**,shared/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/scheduled/ingest-public-sources",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/scheduled/ingest-instagram",
      "schedule": "30 5 */2 * *"
    },
    {
      "path": "/api/scheduled/weekly-executive-report",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron/prune-events",
      "schedule": "0 6 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/api/oauth/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/eventos/:slug",
      "destination": "/api"
    },
    {
      "source": "/og/:path*",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/agenda",
      "destination": "/api"
    },
    {
      "source": "/palcos-da-baixada",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
